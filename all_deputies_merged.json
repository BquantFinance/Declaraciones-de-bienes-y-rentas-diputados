# Helper functions
def get_deputy_photo(deputy_index):
    """Get deputy photo from fotos_diputados folder"""
    photo_path = f"fotos_diputados/deputy_{deputy_index:03d}.jpg"
    if os.path.exists(photo_path):
        return photo_path
    photo_path = f"fotos_diputados/deputy_{deputy_index:04d}.jpg"
    if os.path.exists(photo_path):
        return photo_path
    return None

def get_hemiciclo_seat(deputy_index):
    """Get hemiciclo seat visualization"""
    pattern = f"hemiciclo/hemi_{deputy_index:04d}_*.gif"
    files = glob.glob(pattern)
    if files:
        return files[0]
    return None

def get_party_logo(party_name):
    """Get party logo from deputy_photos folder"""
    if not party_name:
        return None
    
    # Try different possible filenames for party logos
    possible_names = [
        f"deputy_photos/{party_name.lower()}.png",
        f"deputy_photos/{party_name.lower()}.jpg",
        f"deputy_photos/{party_name.upper()}.png",
        f"deputy_photos/{party_name.upper()}.jpg",
        f"deputy_photos/{party_name}.png",
        f"deputy_photos/{party_name}.jpg",
    ]
    
    # Also try removing spaces and special characters
    clean_name = party_name.replace(' ', '').replace('-', '')
    possible_names.extend([
        f"deputy_photos/{clean_name.lower()}.png",
        f"deputy_photos/{clean_name.lower()}.jpg",
        f"deputy_photos/{clean_name.upper()}.png",
        f"deputy_photos/{clean_name.upper()}.jpg",
    ])
    
    # Check each possible filename
    for path in possible_names:
        if os.path.exists(path):
            return path
    
    return None

# Load all data
def load_all_data():
    """Load JSON and CSV data"""
    try:
        # Load JSON data
        with open('all_deputies_merged.json', 'r', encoding='utf-8') as f:
            json_data = json.load(f)
        
        # Load CSV data
        csv_mapping = {}
        try:
            deputies_csv = pd.read_csv('deputies_data.csv', encoding='utf-8')
            for _, row in deputies_csv.iterrows():
                name = row.get('name', '').upper()
                csv_mapping[name] = {
                    'cod_parlamentario': row.get('cod_parlamentario', None),
                    'partido': row.get('Partido', row.get('partido', '')),
                    'twitter': row.get('twitter', ''),
                    'instagram': row.get('instagram', ''),
                    'facebook': row.get('facebook', ''),
                    'website': row.get('website', '')
                }
        except Exception as e:
            st.warning(f"Could not load deputies_data.csv: {e}")
        
        # Process data
        processed_data = []
        for entry in json_data:
            if 'data' in entry and entry['data']:
                data = entry['data']
                personal_info = data.get('informacion_personal', {})
                name = personal_info.get('nombre_y_apellidos', '').upper()
                
                # Get deputy index from source file
                source_file = entry.get('source_file', '')
                deputy_idx = 1
                if 'deputy_' in source_file:
                    try:
                        deputy_idx = int(source_file.split('deputy_')[1].split('_')[0])
                    except:
                        pass
                
                # Override with cod_parlamentario if available
                csv_info = csv_mapping.get(name, {})
                if csv_info.get('cod_parlamentario'):
                    try:
                        deputy_idx = int(csv_info['cod_parlamentario'])
                    except:
                        pass
                
                processed_data.append({
                    'deputy_index': deputy_idx,
                    'Nombre': name,
                    'Cargo': personal_info.get('cargo', 'Diputado'),
                    'Circunscripción': personal_info.get('circunscripcion', ''),
                    'Estado Civil': personal_info.get('estado_civil', ''),
                    'Régimen Económico': personal_info.get('regimen_economico_matrimonial', ''),
                    'Partido': csv_info.get('partido', ''),
                    'Twitter': csv_info.get('twitter', ''),
                    'Instagram': csv_info.get('instagram', ''),
                    'Facebook': csv_info.get('facebook', ''),
                    'Website': csv_info.get('website', '')
                })
        
        return pd.DataFrame(processed_data), json_data
        
    except FileNotFoundError:
        st.error("No se encuentra el archivo 'all_deputies_merged.json'")
        return pd.DataFrame(), []
    except Exception as e:
        st.error(f"Error al procesar los archivos: {str(e)}")
        return pd.DataFrame(), []

